# Copy to .env only if you do not already have one. Shell variables take precedence.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
OPENROUTER_API_KEY=

# Existing defaults; omit to retain them.
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# CARTESIA_VOICE_ID=86e30c1d-714b-4074-a1f2-1cb6b552fb49

# Optional: editable UTF-8 system instructions, relative to the project root.
# SYSTEM_PROMPT_FILE=config/system_prompt.md

# Required: your local openWakeWord ONNX model. Paths are relative to this project.
WAKEWORD_MODEL_PATH=models/sbem.onnx
WAKEWORD_THRESHOLD=0.5
# Listening window after each completed exchange; pauses during speech/processing/tools.
CONVERSATION_IDLE_SECS=30

# Optional robot tools: copy config/robot.example.json and configure the interfaces.
# ROBOT_CONFIG=config/robot.json
