{
  "servers": [
    {
      "name": "sbem-http",
      "enabled": false,
      "transport": "http",
      "url": "http://127.0.0.1:8000/mcp",
      "headers": {
        "Authorization": "Bearer ${SBEM_MCP_TOKEN}"
      },
      "tools": null
    },
    {
      "name": "sbem-stdio",
      "enabled": false,
      "transport": "stdio",
      "command": "/absolute/path/to/robot-server/.venv/bin/python",
      "args": ["/absolute/path/to/robot-server/server.py"],
      "env": {
        "ROS_DOMAIN_ID": "0"
      },
      "tools": null
    },
    {
      "name": "ros-mcp-server",
      "command": "uvx",
      "args": [
        "ros-mcp",
        "--transport=stdio"
      ],
      "disabled": false
    }
  ]
}
